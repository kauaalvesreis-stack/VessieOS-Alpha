import "gui" as ui;
import "math" as m;

var expressao = "";
var display = null;

func atualizar() {
    display.setText(expressao == "" ? "0" : expressao);
}

func pressionar(valor) {
    if (valor == "C") {
        expressao = "";
    } else if (valor == "=") {
        try {
            var r = m.evalExpr(expressao);
            expressao = "" + r;
        } catch (erro) {
            expressao = "Erro";
        }
    } else if (valor == "<") {
        expressao = string.substring(expressao, 0, string.length(expressao) - 1);
    } else {
        expressao = expressao + valor;
    }
    atualizar();
}

func main() {
    var win = ui.createWindow("Calculadora", 300, 380);
    var wrap = ui.panel();
    display = ui.textBox("", "0");
    display.setEditable(false);
    win.add(display);

    var teclas = ["7","8","9","/","4","5","6","*","1","2","3","-","0",".","=","+","C","<"];
    var linha = null;
    var i = 0;
    while (i < teclas.length()) {
        if (i % 4 == 0) {
            linha = ui.panel();
            linha.setStyle("display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin-top:6px;");
            win.add(linha);
        }
        var t = teclas[i];
        var b = ui.button(t, func() { pressionar(t); });
        linha.add(b);
        i = i + 1;
    }

    win.show();
    atualizar();
}
main();