import "gui" as ui;
import "file" as fs;

var editor = null;

func main() {
    var win = ui.createWindow("Bloco de Notas", 520, 400);
    var barra = ui.panel();
    barra.setStyle("display:flex;gap:6px;margin-bottom:6px;");
    var btnAbrir = ui.button("Abrir", func() {
        var nome = ui.prompt("Nome do arquivo:", "nota.txt");
        if (nome != null) {
            try {
                editor.setText(fs.read("/C/Users/admin/" + nome));
            } catch (erro) {
                editor.setText("");
            }
        }
    });
    var btnSalvar = ui.button("Salvar", func() {
        var nome = ui.prompt("Nome do arquivo:", "nota.txt");
        if (nome != null) {
            fs.write("/C/Users/admin/" + nome, editor.getText());
            ui.notify("Bloco de Notas", "Arquivo salvo: " + nome, "💾");
        }
    });
    barra.add(btnAbrir);
    barra.add(btnSalvar);
    win.add(barra);
    editor = ui.textBox("", "");
    win.add(editor);
    win.show();
}
main();