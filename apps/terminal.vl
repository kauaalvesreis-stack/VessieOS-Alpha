import "gui" as ui;
import "system" as sys;
import "file" as fs;

var win = null;
var output = null;
var input = null;

func imprimir(texto) {
    var linha = document.createElement("div");
    linha.textContent = texto;
    linha.style.cssText = "white-space:pre-wrap;color:#9f9;font-family:monospace;";
    output.appendChild(linha);
    output.scrollTop = output.scrollHeight;
}

func executar(cmd) {
    var partes = string.split(cmd, " ");
    var comando = partes[0];
    if (comando == "help") {
        imprimir("Comandos: help, ls, cat <arq>, echo <txt>, clear, sysinfo, date, whoami, ver");
    } else if (comando == "ls") {
        var itens = fs.list("/apps");
        for (var item in itens) {
            imprimir(item.name + "  (" + item.type + ")");
        }
    } else if (comando == "cat") {
        try {
            imprimir(fs.read("/apps/" + partes[1]));
        } catch (erro) {
            imprimir("Arquivo nao encontrado: " + partes[1]);
        }
    } else if (comando == "echo") {
        imprimir(string.join(partes, " "));
    } else if (comando == "clear") {
        output.innerHTML = "";
    } else if (comando == "sysinfo") {
        imprimir("VessieLang v1.0 - " + sys.platform() + " - usuario: " + sys.user());
    } else if (comando == "date") {
        var d = sys.datetime();
        imprimir(d.day + "/" + d.month + "/" + d.year + " " + d.hour + ":" + d.minute);
    } else if (comando == "whoami") {
        imprimir(sys.user());
    } else if (comando == "ver") {
        imprimir(sys.kernelVersion());
    } else if (comando != "") {
        imprimir("Comando desconhecido: " + comando);
    }
}

func main() {
    win = ui.createWindow("Terminal", 560, 380);
    output = document.createElement("div");
    output.style.cssText = "flex:1;overflow:auto;background:rgba(0,0,0,0.55);border-radius:6px;padding:8px;font-family:monospace;font-size:13px;min-height:240px;";
    input = document.createElement("input");
    input.className = "gui-textbox";
    input.placeholder = "Digite um comando... (help para ajuda)";
    input.style.marginTop = "6px";
    input.addEventListener("keydown", func(e) {
        if (e.key == "Enter") {
            var cmd = input.value;
            imprimir("admin@vessie:/$ " + cmd);
            input.value = "";
            executar(cmd);
        }
    });
    win.add(output);
    win.add(input);
    win.show();
    imprimir("VessieLang Terminal v1.0 - digite 'help' para ver os comandos");
    input.focus();
}
main();