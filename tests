// Teste dos scripts .vl do projeto
import { parse } from '../js/interpreter/parser.js';
import { readFile } from 'fs/promises';

const files = ['apps/terminal.vl', 'apps/calculator.vl', 'apps/notepad.vl'];
let ok = true;
for (const f of files) {
    try {
        const code = await readFile(f, 'utf8');
        parse(code);
        console.log('OK  :', f);
    } catch (e) {
        ok = false;
        console.log('ERRO:', f, '-', e.message);
    }
}
process.exit(ok ? 0 : 1);